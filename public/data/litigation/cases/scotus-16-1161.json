ence":{"document":null,"quote":null,"sourceId":"scotus-docket","terms":null,"url":"https://www.supremecourt.gov/search.aspx?filename=/docket/docketfiles/html/public/16-1161.html"},"id":"scotus-16-1161-e84","significance":"routine"}],"externalIds":{"scotusDocket":"16-1161"},"firstObservedAt":"2026-11-20T01:12:59Z","id":"scotus-16-1161","issueTags":[{"matchCount":null,"matchedField":"questions presented","matchedText":"entertain a statewide challenge to Wisconsin's redistricting plan, instead of requiring a district-by-district","ruleId":"tag-redist-2","tag":"redistricting"},{"matchCount":null,"matchedField":"questions presented","matchedText":"redistricting plan was an impermissible partisan gerrymander, even though it was undisputed that the","ruleId":"tag-partisan-1","tag":"partisan-gerrymandering"}],"jurisdiction":"Federal","lastCheckedAt":"2026-11-21T17:38:34Z","latestDispositiveEntry":{"date":"2018-06-18","eventType":"decision","ruleId":"sc-opinion","text":"Judgment VACATED and case REMANDED. Roberts, C. J., delivered the opinion of the Court, in which Kennedy, Ginsburg, Breyer, Alito, Sotomayor, and Kagan, JJ., joined, and in which Thomas and Gorsuch, JJ., joined except as to Part III. Kagan, J., filed a concurring opinion, in which Ginsburg, Breyer, and Sotomayor, JJ., joined. Thomas, J., filed an opinion concurring in part and concurring in the judgment, in which Gorsuch, J., joined."},"linkedNote":"Linked with 16A1149","lowerCourt":{"caseNumbers":["15-cv-421-bbc"],"decisionDate":"2016-11-21","name":"United States District Court for the Western District of Wisconsin","rehearingDeniedDate":null},"natureOfSuit":null,"origin":null,"parties":[],"petitionerTitle":"Beverly R. Gill, et al., Appellants","publication":null,"questionsPresented":{"text":"16-1161 GILL V. WHITFORD\nDECISION BELOW: 218 F.Supp.3d 837\nLOWER COURT CASE NUMBER: 15-cv-421-bbc\n\nQUESTION PRESENTED:\n\n1.Did the district court violate Vieth v. Jubelirer, 541 U.S. 267 (2004), when it held that it had\nthe authority to entertain a statewide challenge to Wisconsin's redistricting plan, instead of\nrequiring a district-by-district analysis?\n2. Did the district court violate Vieth when it held that Wisconsin's redistricting plan was an\nimpermissible partisan gerrymander, even though it was undisputed that the plan complies\nwith traditional redistricting principles?\n3. Did the district court violate Vieth by adopting a watered-down version of the partisan-\ngerrymandering test employed by the plurality in Davis v. Bandemer, 478 U.S. 109 (1986)?\n4. Are Defendants entitled, at a minimum, to present additional evidence showing that they\nwould have prevailed under the district court's test, which the court announced only after the\nrecord had closed?\n5. Are partisan-gerrymandering claims justiciable?\n\nFURTHER CONSIDERATION OF THE QUESTION OF JURISDICTION IS\nPOSTPONED TO THE HEARING OF THE CASE ON THE MERITS.\n\nJURISDICTION NOTED 6/19/2017","textHash":"e3535f547cef33626c189db63a05a339353b2e1f0689d0c6b6219543f87686f1","url":"https://www.supremecourt.gov/qp/16-01161qp.pdf"},"relatedDockets":[],"removedTags":[],"respondentTitle":"William Whitford, et al.","sameLowerCourt":[],"selection":null,"sourceId":"scotus-docket","sourceLastActivity":"2018-08-29","sourcePublishedAt":"2025-08-20","sourceUrl":"https://www.supremecourt.gov/search.aspx?filename=/docket/docketfiles/html/public/16-1161.html","stateFips":["55"],"verification":{"checkedAt":"2026-11-21T17:38:34Z","method":"automated_primary_retrieval","note":"Read from the Supreme Court's public docket page and schema-validated. Not reviewed by a lawyer.","status":"verified_primary"}}
