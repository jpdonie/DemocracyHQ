ificationRule":"ca-passed","code":null,"date":"2025-08-21","eventType":"passed_house","historyId":"118098747","location":"Assembly","sequence":17,"significance":"major","source":null,"status":null,"text":"Read third time. Passed. (Ayes 77. Noes 0. Page 2705.) Ordered to the Senate.","time":null,"votes":[]},{"classificationRule":"ca-other","code":null,"date":"2025-08-21","eventType":"legislative_action","historyId":"118098748","location":"Senate","sequence":18,"significance":"routine","source":null,"status":null,"text":"In Senate. Ordered to engrossing and enrolling.","time":null,"votes":[]},{"classificationRule":"ca-enrolled","code":null,"date":"2025-08-27","eventType":"enrolled","historyId":"118098749","location":"Governor","sequence":19,"significance":"major","source":null,"status":null,"text":"Enrolled and presented to the Governor at 11 a.m.","time":null,"votes":[]},{"classificationRule":"ca-approved","code":null,"date":"2025-08-28","eventType":"approved_by_governor","historyId":"118098750","location":"Governor","sequence":20,"significance":"major","source":null,"status":null,"text":"Approved by the Governor.","time":null,"votes":[]},{"classificationRule":"ca-chaptered","code":null,"date":"2025-08-28","eventType":"chaptered","historyId":"118098751","location":"Secretary of State","sequence":21,"significance":"major","source":null,"status":null,"text":"Chaptered by Secretary of State. Chapter 101, Statutes of 2025.","time":null,"votes":[]}],"affectedStatutes":[{"action":"IS_REPEALED","code":"ELEC","text":"Section 3108 of the Elections Code is repealed."}],"approvedDate":"2025-08-28","chapter":{"citation":"Chapter 101, Statutes of 2025","number":"101","type":"CHP","year":"2025"},"chapteredDate":"2025-08-28","committees":[],"conditions":[],"contentHash":"d095c776256d2441b2f54b50eafc890f83e45393b232afabe9207f012bda35ce","cosponsorCount":null,"digest":"Existing law authorizes an individual who registers to vote at least 15 days before an election day, to vote in that election by a regular ballot. Existing law permits an individual who is eligible to register to vote to complete a registration application during the 14 days immediately preceding an election or on the day of the election, and to vote by conditional ballot or regular ballot, as specified. Existing law provides that otherwise qualified military and overseas voters and voters with disabilities may complete a conditional voter registration and cast a provisional ballot or nonprovisional ballot under those provisions. Existing law also permits a military or overseas voter to register after the closing date of registration if the voter is released from service after the closing date, returns to the voter’s county of residence, and is not a registered voter in that county, or if the voter is required to move under official active duty military orders after the closing date.\n\nThis bill would repeal the latter provision as obsolete due to the inclusion of military and overseas voters in the general conditional voter registration process.","digestDate":null,"digestVersion":null,"effective":{"basis":"not_verified","date":null,"note":"No effective date is recorded in the official bill data and DemocracyHQ has not verified one. A non-urgency statute enacted in a regular session generally takes effect on January 1 after a 90-day period (Cal. Const. art. IV, § 8(c)), but a bill may state other operative dates."},"expiryClauses":[],"firstObservedAt":"2026-11-20T01:12:59Z","id":"ca-20252026-sb621","identifier":"SB 621","indicators":{"Appropriation":"NO","BudgetBill":"NO","Election":"NO","FiscalCommittee":"NO","ImmediateEffect":"NO","LocalProgram":"NO","TaxLevy":"NO","Urgency":"NO","UsualCurrentExpenses":"NO","VoteRequired":"MAJORITY"},"introducedDate":"2025-02-20","issueTags":[{"matchCount":null,"matchedField":"official subject line","matchedText":"Voter registration: military and overseas voters.","ruleId":"tag-reg-1","tag":"registration"},{"matchCount":null,"matchedField":"Le