on":"Senate","sequence":12,"significance":"routine","source":null,"status":null,"text":"From committee: Amend, and do pass as amended. (Ayes 4. Noes 0.) (June 16).","time":null,"votes":[]},{"classificationRule":"ca-amended","code":null,"date":"2026-06-17","eventType":"amended","historyId":"119100964","location":"Senate","sequence":13,"significance":"routine","source":null,"status":null,"text":"Read second time and amended. Ordered to third reading.","time":null,"votes":[]},{"classificationRule":"ca-passed","code":null,"date":"2026-08-18","eventType":"passed_house","historyId":"119100965","location":"Senate","sequence":14,"significance":"major","source":null,"status":null,"text":"Read third time. Passed. Ordered to the Assembly. (Ayes 29. Noes 7. Page 5521.).","time":null,"votes":[]},{"classificationRule":"ca-other","code":null,"date":"2026-08-18","eventType":"legislative_action","historyId":"119100966","location":"Assembly","sequence":15,"significance":"routine","source":null,"status":null,"text":"In Assembly. Concurrence in Senate amendments pending.","time":null,"votes":[]},{"classificationRule":"ca-concurred","code":null,"date":"2026-08-19","eventType":"concurred","historyId":"119100967","location":"Assembly","sequence":16,"significance":"major","source":null,"status":null,"text":"Senate amendments concurred in. To Engrossing and Enrolling. (Ayes 55. Noes 13. Page 6254.).","time":null,"votes":[]},{"classificationRule":"ca-enrolled","code":null,"date":"2026-08-25","eventType":"enrolled","historyId":"119100968","location":"Governor","sequence":17,"significance":"major","source":null,"status":null,"text":"Enrolled and presented to the Governor at 4 p.m.","time":null,"votes":[]},{"classificationRule":"ca-vetoed","code":null,"date":"2026-09-27","eventType":"vetoed","historyId":"119100969","location":"Assembly","sequence":18,"significance":"major","source":null,"status":null,"text":"Vetoed by Governor.","time":null,"votes":[]}],"affectedStatutes":[{"action":"IS_ADDED","code":"ELEC","text":"Section 12325 is added to the Elections Code, to read:"}],"approvedDate":null,"chapter":null,"chapteredDate":null,"committees":[],"conditions":[],"contentHash":"68364e4751777301822fe159743fa0fa5afd1680075e262c7ccbdd72fb8572d1","cosponsorCount":null,"digest":"Existing law requires a county elections official to divide each jurisdiction within the county into precincts and to appoint a precinct board for each precinct at least 29 days before an election within the jurisdiction. Any voter may apply to the county elections official for appointment as a precinct board member.\n\nUntil January 1, 2033, this bill would authorize a county elections official to propose, and a county board of supervisors to adopt, a system for each election in the county in which individuals are randomly selected to serve as precinct board members. The bill would make every registered voter who resides in the jurisdiction eligible to be selected, but would authorize an eligible person to be excused if the person is 70 years of age or older, or if the elections official determines the person is in ill health or has another good and sufficient reason. The bill would also authorize the elections official to disqualify a person from service if the elections official, in their discretion, deems the person unsuitable to serve. The bill would require an elections official to mail written notice to each person who is selected as a precinct board member at least 15 days before the reporting date designated by the elections official. On the reporting date, the person selected to serve would be required to report to the office of the elections official or another designated location to complete any informational forms and receive training, as provided.","digestDate":null,"digestVersion":null,"effective":{"basis":"not_enacted","date":null,"note":"Vetoed by the Governor. A vetoed bill is not enacted unless the Legislature overrides the veto (Cal. Const. art. IV, § 10(a)); no override is recorded in the data as of the last check. It has no effective date."},"expiryClauses":[{"date":"2033-01-01","ruleId":"ca-sunset-1","text":"This section shall remain in effect only until January 1, 2033, and as of that date is repealed.","versionId":"20250AB156295ENR"}],"firstObservedAt":"2026-11-20T01:12:59Z","id":"ca-20252026-ab1562","identifier":"AB 1562","indicators":{"Appropriation":"NO","BudgetBill":"NO","Election":"NO","FiscalCommittee":"NO","ImmediateEffect":"NO","LocalProgram":"NO","TaxLevy":"NO","Urgency":"NO","UsualCurrentExpenses":"NO","VoteRequired":"MAJORITY"},"introducedDate":"2026-01-08","issueTags":[{"matchCount":null,"matchedField":"official subject line","matchedText":"Elections: precinct board members.","ruleId":"tag-admin-2","tag":"election-administration"}],"judicialNote":"Legislative status does not show whether a court has blocked, narrowed or upheld any provision. Check the linked litigation, which may be incomplete.","lastActionDate":"2026-09-27","lastActionText":"Vetoed by Governor.","lastCheckedAt":"2026-11-23T21:40:26Z","leadAuthors":"Introduced by Assembly Member Jackson","legislativeStatus":{"currentHouse":"Assembly","currentLocation":null,"currentStatus":"Vetoed","measureState":"Enrolled"},"legislativeSubjects":[],"measureType":"Assembly Bill","officialUrl":"https://leginfo.legislature.ca.gov/faces/billNavClient.xhtml?bill_id=202520260AB1562","policyArea":null,"relatedMeasures":[],"selection":{"matchedField":"official subject line (latest version)","matchedText":"Elections","ruleId":"ca-select-2"},"session":"2025-2026 Regular Session","shortTitles":[],"sourceId":"ca-leginfo-bulk","sourcePublishedAt":"2026-11-23T05:26:07Z","sourceRecordUrl":null,"sponsors":[],"state":"06","stateAbbr":"CA","subject":"Elections: precinct board members.","title":"An act to add and repeal Section 12325 of the Elections Code, relating to elections.","verification":{"checkedAt":"2026-11-23T21:40:26Z","method":"automated_primary_retrieval","note":"Parsed 