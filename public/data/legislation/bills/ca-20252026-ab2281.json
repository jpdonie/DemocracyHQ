mmittees":[],"conditions":[],"contentHash":"1ca203f0c085bef91e86628390ab8a572d29f4cad215a3600cf1c3e940759045","cosponsorCount":null,"digest":"Existing law establishes the Office of Elections Cybersecurity within the Secretary of State’s office to coordinate efforts between the Secretary of State and local elections officials to reduce the likelihood and severity of cyber incidents and to monitor and counteract false or misleading information regarding the electoral process. Existing law requires the Office of Elections Cybersecurity, among other things, to develop best practices for protecting against threats to election cybersecurity in consultation with federal, state, and local agencies and private organizations.\n\nThis bill would also authorize the office to consult with academic researchers for that purpose. The bill would require the office to assess whether additional state resources are needed to replace election cybersecurity resources previously provided by the federal government.","digestDate":null,"digestVersion":null,"effective":{"basis":"not_verified","date":null,"note":"No effective date is recorded in the official bill data and DemocracyHQ has not verified one. A non-urgency statute enacted in a regular session generally takes effect on January 1 after a 90-day period (Cal. Const. art. IV, § 8(c)), but a bill may state other operative dates."},"expiryClauses":[],"firstObservedAt":"2026-11-20T01:12:59Z","id":"ca-20252026-ab2281","identifier":"AB 2281","indicators":{"Appropriation":"NO","BudgetBill":"NO","Election":"NO","FiscalCommittee":"YES","ImmediateEffect":"NO","LocalProgram":"NO","TaxLevy":"NO","Urgency":"NO","UsualCurrentExpenses":"NO","VoteRequired":"MAJORITY"},"introducedDate":"2026-02-19","issueTags":[{"matchCount":null,"matchedField":"official subject line","matchedText":"Office of Elections Cybersecurity.","ruleId":"tag-admin-2","tag":"election-administration"}],"judicialNote":"Legislative status does not show whether a court has blocked, 