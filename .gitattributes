# Text files are stored and checked out with LF line endings on every platform.
* text=auto eol=lf

# Binary files, never converted.
*.png binary
*.jpg binary
*.ico binary
*.pbf binary
*.woff2 binary
*.zip binary
*.pdf binary

# The data files are generated by the pipeline (pipeline/dhq/run.py) and committed by the scheduled workflow.
# GitHub collapses them in diffs and leaves them out of the language statistics; git shows no line diff for them.
public/data/** linguist-generated=true -diff
