# DemocracyHQ environment variables
#
# Copy this file to `.env` in the repository root for local use. `.env` is git-ignored. Never commit a real key.
# The pipeline reads `.env` when it starts; a variable already set in the environment takes precedence.
# None of these is required: without them the map, the Census data, the Supreme Court
# dockets and the California legislation all build and run. A missing key only means the
# matching optional source is recorded as "credential_missing" on the Sources page.
#
# Where each value comes from in GitHub Actions (Settings > Secrets and variables > Actions):
#   - COURTLISTENER_API_TOKEN and OPENSTATES_API_KEY: repository secrets of the same name, set on the
#     step of the ingestion workflow (.github/workflows/ingest.yml) that runs the pipeline.
#   - DHQ_USER_AGENT: a repository variable of the same name (the Variables tab), not a secret. A
#     secret with that name is not read.
#   - DHQ_NOW and DHQ_ALLOW_NOW: not set by any workflow.
#   - VITE_REPO_URL and VITE_SITE_URL: set by the Pages workflow (.github/workflows/deploy.yml) itself.
# The pipeline values are used only by the Python pipeline and are never built into the website.
# The VITE_ values are public and are built into it.

# --- Optional pipeline credentials -------------------------------------------------

# CourtListener REST API token (Free Law Project). Lists decisions of federal district courts and of
# the courts of the states, selects the election cases among them and publishes them under
# public/data/decisions/, which the site shows; and reads the dockets of voting cases in the federal
# district courts from the RECAP Archive. One run sends the search at most 300 requests
# (DHQ_CL_REQUESTS sets another number) and at most 300 more for dockets (DHQ_CL_DOCKET_REQUESTS).
# Get one at https://www.courtlistener.com/help/api/rest/ (free account).
COURTLISTENER_API_TOKEN=

# Open States API v3 key (Plural Policy). Lists the sessions of the state legislatures, whose bulk
# archives the "openstates" stage reads into public/data/state-legislation/.
# See https://docs.openstates.org/api-v3/ for how to register for a key (free account).
OPENSTATES_API_KEY=

# 0 leaves unasked the legislature sites that Open States gives over http only (rule secure-link-1).
# DHQ_LINK_CHECKS=1

# --- Optional pipeline settings ----------------------------------------------------

# Client name sent with every request the pipeline makes. The default is generic
# ("election-law-research-pipeline/0.1 (python-requests)"). If you operate a public deployment,
# a name with a contact address lets a publisher reach you instead of blocking you.
# DHQ_USER_AGENT=my-deployment/1.0 (+https://example.org/contact)

# Pin the pipeline clock to a full UTC timestamp, so that output is reproducible. Used by tests.
# Outside pytest it is honoured only when DHQ_ALLOW_NOW=1 is also set, so that a value left here
# cannot back-date a real run; without it the value is ignored with a warning. When it is honoured,
# a value that is not a full UTC timestamp stops the run with exit code 2 before anything is published.
# DHQ_NOW=2026-01-01T00:00:00Z
# DHQ_ALLOW_NOW=1

# --- Optional build-time settings for the website (public, not secret) --------------

# Repository URL, of the form https://github.com/OWNER/REPO (any other value is ignored).
# Turns on the "Report a correction" links, which open the repository's Data correction issue
# form with the record filled in. Vite reads it from `.env` or the environment at build time.
# VITE_REPO_URL=https://github.com/OWNER/REPO

# Public https address of the deployed site. Makes the social-card image address absolute and
# adds the page address to index.html. vite.config.ts reads it from the environment of the build
# command, not from `.env`, so set it there: VITE_SITE_URL=https://OWNER.github.io/REPO npm run build
# VITE_SITE_URL=https://OWNER.github.io/REPO
